# ==============================================================================
# Sensitive User & Anonymization Data (152-FZ)
# ==============================================================================
# Cryptographic key files & mapping dictionaries (.depmap contains real PII mappings)
*.depmap

# Raw documents, spreadsheets, data dumps that may contain personal data
*.xlsx
*.xlsm
*.xls
*.xltx
*.xltm
*.csv
*.tsv
*.pdf
*.docx
*.doc
*.odt
*.rtf
*.parquet
*.db
*.sqlite
*.sqlite3
mock_documents/

# Archives containing user data
*.zip
*.7z
*.rar
*.tar.gz

# ==============================================================================
# Secrets, Credentials & Environment Configs
# ==============================================================================
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.secret
*.token
id_rsa*
id_ed25519*
credentials.json
service-account*.json

